@page "/"

<PageTitle>Home - Blazor Minimal App</PageTitle>

<div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6">
        <h1 class="text-2xl font-bold text-gray-900">Minimal Blazor Client/Server Template</h1>
        <p class="mt-1 max-w-2xl text-sm text-gray-500">A clean, minimal template for ASP.NET Core with Blazor WebAssembly</p>
    </div>
    <div class="border-t border-gray-200">
        <dl>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">Framework</dt>
                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">.NET 8 with Blazor WebAssembly</dd>
            </div>
            <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">CSS Framework</dt>
                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">Tailwind CSS (via CDN)</dd>
            </div>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">Database</dt>
                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">SQLite with Entity Framework Core</dd>
            </div>
            <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">Real-time Communication</dt>
                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">SignalR</dd>
            </div>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
                <dt class="text-sm font-medium text-gray-500">Features</dt>
                <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                    <ul class="border border-gray-200 rounded-md divide-y divide-gray-200">
                        <li class="pl-3 pr-4 py-3 flex items-center justify-between text-sm">
                            <div class="w-0 flex-1 flex items-center">
                                <span class="ml-2 flex-1 w-0 truncate">Todo List with Entity Framework and SignalR</span>
                            </div>
                            <div class="ml-4 flex-shrink-0">
                                <a href="todo" class="font-medium text-blue-600 hover:text-blue-500">View</a>
                            </div>
                        </li>
                    </ul>
                </dd>
            </div>
        </dl>
    </div>
</div>
